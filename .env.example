# QuadAnon Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# ─── Supabase (required for backend features) ─────────────────────────────
# From https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Server-side only (Edge Functions / CI). Never prefix with VITE_ ──────
# SUPABASE_SERVICE_ROLE_KEY=
# EMAIL_HASH_SECRET=          # openssl rand -hex 32
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com